                    <div class="status-badge ${member.status === 'offline' ? 'offline' : member.status === 'busy' ? 'busy' : ''}"></div>
                </div>
                <div class="member-info">
                    <h3 class="member-name">${member.name}</h3>
                    <p class="member-position">${member.position}</p>
                    <p class="member-department">${member.department}</p>
                    <p class="member-bio">${member.bio}</p>
                    <div class="member-tags">
                        ${member.skills.slice(0, 2).map(skill => `<span class="tag">${skill}</span>`).join('')}
                    </div>
                    <div class="member-actions">
                        <button class="action-btn">Profil</button>
                        <button class="action-btn primary">Connecter</button>
                    </div>
                </div>
            </div>
        `;
    }

    // Fonction pour afficher les membres
    function renderMembers() {
        const grid = document.getElementById('membersGrid');
        grid.innerHTML = filteredMembers.map(member => createMemberCard(member)).join('');
        document.getElementById('resultCount').textContent = filteredMembers.length;
    }

    // Fonction de recherche
    function searchMembers(query) {
        const lowercaseQuery = query.toLowerCase();
        filteredMembers = members.filter(member => {
            const matchesSearch = member.name.toLowerCase().includes(lowercaseQuery) ||
                                member.position.toLowerCase().includes(lowercaseQuery) ||
                                member.skills.some(skill => skill.toLowerCase().includes(lowercaseQuery));
            const matchesFilter = currentFilter === 'all' || member.category === currentFilter;
            return matchesSearch && matchesFilter;
        });
        renderMembers();
    }

    // Fonction de filtre
    function filterMembers(category) {
        currentFilter = category;
        const searchQuery = document.getElementById('searchInput').value;
        searchMembers(searchQuery);
        
        // Mise à jour des boutons actifs
        document.querySelectorAll('.filter-btn').forEach(btn => {
            btn.classList.remove('active');
            if (btn.dataset.filter === category) {
                btn.classList.add('active');
            }
        });
    }

    // Fonction pour ouvrir le modal
    function openModal(memberId) {
        const member = members.find(m => m.id === memberId);
        if (!member) return;

        document.getElementById('modalAvatar').textContent = member.avatar;
        document.getElementById('modalName').textContent = member.name;
        document.getElementById('modalPosition').textContent = member.position;
        document.getElementById('modalDepartment').textContent = member.department;
        document.getElementById('modalProjects').textContent = member.projects;
        document.getElementById('modalExperience').textContent = member.experience;
        document.getElementById('modalConnections').textContent = member.connections;
        document.getElementById('modalBio').textContent = member.bio;

        const skillsHTML = member.skills.map(skill => {
            const colors = ['', 'red', 'green'];
            const colorClass = colors[member.skills.indexOf(skill) % colors.length];
            return `<span class="tag ${colorClass}">${skill}</span>`;
        }).join('');
        document.getElementById('modalSkills').innerHTML = skillsHTML;

        const contactHTML = member.contact.map(contact => 
            `<button class="contact-link">${contact}</button>`
        ).join('');
        document.getElementById('modalContact').innerHTML = contactHTML;

        document.getElementById('modal').classList.add('active');
    }

    // Fonction pour fermer le modal
    function closeModal() {
        document.getElementById('modal').classList.remove('active');
    }

    // Événements
    document.getElementById('searchInput').addEventListener('input', (e) => {
        searchMembers(e.target.value);
    });

    document.querySelectorAll('.filter-btn').forEach(btn => {
        btn.addEventListener('click', () => {
            filterMembers(btn.dataset.filter);
        });
    });

    document.getElementById('gridView').addEventListener('click', () => {
        isListView = false;
        document.getElementById('gridView').classList.add('active');
        document.getElementById('listView').classList.remove('active');
        document.getElementById('membersGrid').classList.remove('list-view');
        renderMembers();
    });

    document.getElementById('listView').addEventListener('click', () => {
        isListView = true;
        document.getElementById('listView').classList.add('active');
        document.getElementById('gridView').classList.remove('active');
        document.getElementById('membersGrid').classList.add('list-view');
        renderMembers();
    });

    // Fermer le modal en cliquant en dehors
    document.getElementById('modal').addEventListener('click', (e) => {
        if (e.target.id === 'modal') {
            closeModal();
        }
    });

    // Initialisation
    renderMembers();
</script>
