    :root {
        --primary: #0f172a;
        --secondary: #1e293b;
        --accent: #00d9ff;
        --accent-alt: #ff006e;
        --text: #e2e8f0;
        --text-muted: #94a3b8;
        --success: #10b981;
        --warning: #f59e0b;
        --danger: #ef4444;
        --glow: 0 0 20px rgba(0, 217, 255, 0.3);
    }

    body {
        font-family: 'Segoe UI', 'Helvetica Neue', sans-serif;
        background: linear-gradient(135deg, var(--primary) 0%, #0d1b2a 50%, var(--primary) 100%);
        color: var(--text);
        min-height: 100vh;
        position: relative;
        overflow-x: hidden;
    }

    /* Animation de fond */
    body::before {
        content: '';
        position: fixed;
        top: 0;
        left: 0;
        width: 100%;
        height: 100%;
        background: 
            radial-gradient(circle at 20% 50%, rgba(0, 217, 255, 0.05) 0%, transparent 50%),
            radial-gradient(circle at 80% 80%, rgba(255, 0, 110, 0.05) 0%, transparent 50%);
        pointer-events: none;
        z-index: -1;
    }

    .container {
        max-width: 1400px;
        margin: 0 auto;
        padding: 40px 20px;
    }

    /* Header */
    header {
        text-align: center;
        margin-bottom: 60px;
        animation: slideDown 0.8s ease-out;
    }

    h1 {
        font-size: 3.5rem;
        font-weight: 800;
        background: linear-gradient(135deg, var(--accent) 0%, var(--accent-alt) 100%);
        -webkit-background-clip: text;
        -webkit-text-fill-color: transparent;
        background-clip: text;
        margin-bottom: 10px;
        letter-spacing: -2px;
    }

    .subtitle {
        color: var(--text-muted);
        font-size: 1.1rem;
        font-weight: 300;
        letter-spacing: 2px;
        text-transform: uppercase;
    }

    /* Barre de contrôle */
    .control-bar {
        display: flex;
        gap: 20px;
        margin-bottom: 40px;
        flex-wrap: wrap;
        align-items: center;
        justify-content: center;
        animation: slideUp 0.8s ease-out 0.2s both;
    }

    .search-box {
        position: relative;
        flex: 1;
        min-width: 250px;
        max-width: 400px;
    }

    .search-box input {
        width: 100%;
        padding: 12px 40px 12px 16px;
        background: var(--secondary);
        border: 2px solid var(--accent);
        border-radius: 12px;
        color: var(--text);
        font-size: 1rem;
        transition: all 0.3s ease;
        outline: none;
    }

    .search-box input:focus {
        box-shadow: var(--glow), 0 0 30px rgba(0, 217, 255, 0.5);
        transform: translateY(-2px);
    }

    .search-icon {
        position: absolute;
        right: 12px;
        top: 50%;
        transform: translateY(-50%);
        color: var(--accent);
        pointer-events: none;
    }

    .filter-group {
        display: flex;
        gap: 10px;
        flex-wrap: wrap;
    }

    .filter-btn {
        padding: 10px 20px;
        background: var(--secondary);
        border: 2px solid var(--accent);
        color: var(--text);
        border-radius: 8px;
        cursor: pointer;
        font-size: 0.9rem;
        font-weight: 600;
        transition: all 0.3s ease;
        text-transform: uppercase;
        letter-spacing: 1px;
    }

    .filter-btn:hover,
    .filter-btn.active {
        background: var(--accent);
        color: var(--primary);
        box-shadow: var(--glow);
        transform: translateY(-2px);
    }

    .view-toggle {
        display: flex;
        gap: 5px;
        background: var(--secondary);
        padding: 5px;
        border-radius: 8px;
        border: 2px solid var(--accent);
    }

    .view-btn {
        padding: 8px 12px;
        background: transparent;
        border: none;
        color: var(--text-muted);
        cursor: pointer;
        font-size: 1.2rem;
        transition: all 0.3s ease;
        border-radius: 6px;
    }

    .view-btn.active {
        background: var(--accent);
        color: var(--primary);
    }

    /* Grid principal */
    .members-grid {
        display: grid;
        grid-template-columns: repeat(auto-fill, minmax(280px, 1fr));
        gap: 30px;
        margin-bottom: 40px;
        animation: fadeIn 0.8s ease-out 0.4s both;
    }

    .members-grid.list-view {
        grid-template-columns: 1fr;
    }

    /* Carte membre */
    .member-card {
        background: linear-gradient(135deg, var(--secondary) 0%, rgba(30, 41, 59, 0.8) 100%);
        border: 2px solid rgba(0, 217, 255, 0.2);
        border-radius: 16px;
        padding: 20px;
        cursor: pointer;
        transition: all 0.3s ease;
        position: relative;
        overflow: hidden;
        display: flex;
        flex-direction: column;
        min-height: 380px;
    }

    .member-card::before {
        content: '';
        position: absolute;
        top: 0;
        left: 0;
        right: 0;
        height: 3px;
        background: linear-gradient(90deg, var(--accent) 0%, var(--accent-alt) 100%);
        transform: scaleX(0);
        transform-origin: left;
        transition: transform 0.3s ease;
    }

    .member-card:hover {
        border-color: var(--accent);
        transform: translateY(-8px);
        box-shadow: var(--glow), 0 20px 40px rgba(0, 0, 0, 0.4);
    }

    .member-card:hover::before {
        transform: scaleX(1);
    }

    .member-card.list-view {
        flex-direction: row;
        min-height: auto;
        gap: 20px;
    }

    .avatar-container {
        position: relative;
        width: 120px;
        height: 120px;
        margin: 0 auto 20px;
        border-radius: 12px;
        overflow: hidden;
        border: 3px solid var(--accent);
        flex-shrink: 0;
    }

    .member-card.list-view .avatar-container {
        margin: 0;
        width: 100px;
        height: 100px;
    }

    .avatar {
        width: 100%;
        height: 100%;
        object-fit: cover;
        background: linear-gradient(135deg, var(--accent) 0%, var(--accent-alt) 100%);
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 2.5rem;
        font-weight: bold;
    }

    .status-badge {
        position: absolute;
        bottom: 0;
        right: 0;
        width: 24px;
        height: 24px;
        background: var(--success);
        border: 3px solid var(--secondary);
        border-radius: 50%;
        animation: pulse 2s infinite;
    }

    .status-badge.offline {
        background: var(--text-muted);
        animation: none;
    }

    .status-badge.busy {
        background: var(--warning);
    }

    @keyframes pulse {
        0%, 100% { box-shadow: 0 0 0 0 var(--success); }
        50% { box-shadow: 0 0 0 8px rgba(16, 185, 129, 0.2); }
    }

    .member-info {
        flex: 1;
        display: flex;
        flex-direction: column;
    }

    .member-name {
        font-size: 1.3rem;
        font-weight: 700;
        margin-bottom: 5px;
        color: var(--text);
    }

    .member-position {
        font-size: 0.9rem;
        color: var(--accent);
        font-weight: 600;
        text-transform: uppercase;
        letter-spacing: 1px;
        margin-bottom: 10px;
    }

    .member-department {
        font-size: 0.85rem;
        color: var(--text-muted);
        margin-bottom: 15px;
    }

    .member-tags {
        display: flex;
        gap: 8px;
        flex-wrap: wrap;
        margin-bottom: 15px;
    }

    .tag {
        padding: 4px 10px;
        background: rgba(0, 217, 255, 0.1);
        border: 1px solid var(--accent);
        border-radius: 20px;
        font-size: 0.75rem;
        color: var(--accent);
        font-weight: 600;
    }

    .tag.red {
        background: rgba(255, 0, 110, 0.1);
        border-color: var(--accent-alt);
        color: var(--accent-alt);
    }

    .tag.green {
        background: rgba(16, 185, 129, 0.1);
        border-color: var(--success);
        color: var(--success);
    }

    .member-bio {
        font-size: 0.85rem;
        color: var(--text-muted);
        line-height: 1.5;
        margin-bottom: 15px;
        flex: 1;
    }

    .member-actions {
        display: flex;
        gap: 10px;
    }

    .action-btn {
        flex: 1;
        padding: 10px 15px;
        border: 2px solid var(--accent);
        background: transparent;
        color: var(--accent);
        border-radius: 8px;
        cursor: pointer;
        font-size: 0.85rem;
        font-weight: 600;
        transition: all 0.3s ease;
        text-transform: uppercase;
        letter-spacing: 0.5px;
    }

    .action-btn:hover {
        background: var(--accent);
        color: var(--primary);
        box-shadow: var(--glow);
    }

    .action-btn.primary {
        background: var(--accent);
        color: var(--primary);
    }

    .action-btn.primary:hover {
        background: var(--accent-alt);
        border-color: var(--accent-alt);
        box-shadow: 0 0 20px rgba(255, 0, 110, 0.3);
    }

    /* Modal détails */
    .modal {
        display: none;
        position: fixed;
        top: 0;
        left: 0;
        width: 100%;
        height: 100%;
        background: rgba(0, 0, 0, 0.8);
